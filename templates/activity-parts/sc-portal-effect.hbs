<section class="tab activity-{{ tab.id }} {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
  {{> "systems/dnd5e/templates/activity/parts/activity-effects.hbs" }}

  <details class="sc-ma-howto" data-sc-panel="howto" {{#if openPanels.howto}}open{{/if}}>
    <summary><i class="fa-solid fa-circle-question" inert></i>{{ localize "SCMOREACTIVITIES.Activities.ScPortal.HowTo.Title" }}</summary>
    <ul>
      <li><i class="fa-solid fa-hand-pointer" inert></i><span>{{{ localize "SCMOREACTIVITIES.Activities.ScPortal.HowTo.Place" }}}</span></li>
      <li><i class="fa-solid fa-door-open" inert></i><span>{{{ localize "SCMOREACTIVITIES.Activities.ScPortal.HowTo.Cross" }}}</span></li>
      <li><i class="fa-solid fa-hourglass-end" inert></i><span>{{{ localize "SCMOREACTIVITIES.Activities.ScPortal.HowTo.Close" }}}</span></li>
    </ul>
  </details>

  <fieldset>
    <legend>{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Sections.Placement" }}</legend>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.PlacementRange.Label" }}</label>
      <div class="form-fields sc-ma-range-fields">
        <input type="text" name="portal.placementRange" value="{{ portal.placementRange }}">
        <select name="portal.rangeShape" data-tooltip="{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.RangeShape.Hint" }}"
                aria-label="{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.RangeShape.Label" }}">
          {{ selectOptions rangeShapeOptions selected=portal.rangeShape valueAttr="value" labelAttr="label" }}
        </select>
      </div>
      <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.PlacementRange.Hint" }}</p>
    </div>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.LinkRange.Label" }}</label>
      <div class="form-fields">
        <input type="text" name="portal.linkRange" value="{{ portal.linkRange }}"
               placeholder="{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.LinkRange.Placeholder" }}">
      </div>
      <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.LinkRange.Hint" }}</p>
    </div>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.Size.Label" }}</label>
      <div class="form-fields">
        <select name="portal.size" aria-label="{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.Size.Label" }}">
          {{ selectOptions sizeOptions selected=portal.size valueAttr="value" labelAttr="label" }}
        </select>
        <select name="portal.shape" data-tooltip="{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.Shape.Hint" }}"
                aria-label="{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.Shape.Label" }}">
          {{ selectOptions shapeOptions selected=portal.shape valueAttr="value" labelAttr="label" }}
        </select>
      </div>
      <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.Size.Hint" }}</p>
    </div>

    <div class="sc-ma-toggles">
      <label class="sc-ma-toggle">
        <input type="checkbox" name="portal.snapToGrid" {{#if portal.snapToGrid}}checked{{/if}}>
        <span>
          <span class="sc-ma-toggle-title">{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.SnapToGrid.Label" }}</span>
          <span class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.SnapToGrid.Hint" }}</span>
        </span>
      </label>
      <label class="sc-ma-toggle">
        <input type="checkbox" name="portal.avoidOccupied" {{#if portal.avoidOccupied}}checked{{/if}}>
        <span>
          <span class="sc-ma-toggle-title">{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.AvoidOccupied.Label" }}</span>
          <span class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.AvoidOccupied.Hint" }}</span>
        </span>
      </label>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Sections.Behavior" }}</legend>

    <div class="sc-ma-toggles">
      <label class="sc-ma-toggle">
        <input type="checkbox" name="portal.oneWay" {{#if portal.oneWay}}checked{{/if}}>
        <span>
          <span class="sc-ma-toggle-title">{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.OneWay.Label" }}</span>
          <span class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.OneWay.Hint" }}</span>
        </span>
      </label>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Sections.Duration" }}</legend>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.MaxUses.Label" }}</label>
      <div class="form-fields">
        <input type="text" name="portal.maxUses" value="{{ portal.maxUses }}"
               placeholder="{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.MaxUses.Placeholder" }}">
      </div>
      <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.MaxUses.Hint" }}</p>
    </div>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.DurationRounds.Label" }}</label>
      <div class="form-fields">
        <input type="text" name="portal.durationRounds" value="{{ portal.durationRounds }}">
      </div>
      <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.DurationRounds.Hint" }}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Sections.Appearance" }}</legend>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.Visibility.Label" }}</label>
      <div class="form-fields">
        <select name="portal.visibility">
          {{ selectOptions visibilityOptions selected=portal.visibility valueAttr="value" labelAttr="label" }}
        </select>
      </div>
      <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.Visibility.Hint" }}</p>
    </div>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.Color.Label" }}</label>
      <div class="form-fields">
        <color-picker name="portal.color" value="{{ portal.color }}"></color-picker>
      </div>
      <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.Color.Hint" }}</p>
    </div>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.EntryImage.Label" }}</label>
      <div class="form-fields">
        <file-picker name="portal.entryImage" type="imagevideo" value="{{ portal.entryImage }}"></file-picker>
      </div>
    </div>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.ExitImage.Label" }}</label>
      <div class="form-fields">
        <file-picker name="portal.exitImage" type="imagevideo" value="{{ portal.exitImage }}"></file-picker>
      </div>
      <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScPortal.Fields.Art.Hint" }}</p>
    </div>
  </fieldset>
</section>
