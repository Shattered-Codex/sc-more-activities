<section class="tab activity-{{ tab.id }} {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
  {{> "systems/dnd5e/templates/activity/parts/activity-effects.hbs" }}

  <fieldset>
    <legend>{{ localize "SCMOREACTIVITIES.Activities.ScIdentify.Sections.Configuration" }}</legend>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.ScIdentify.Fields.Recipient.Label" }}</label>
      <div class="form-fields">
        <select name="recipient">
          {{ selectOptions recipientOptions selected=recipient valueAttr="value" labelAttr="label" }}
        </select>
      </div>
      <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScIdentify.Fields.Recipient.Hint" }}</p>
    </div>

    {{#if showRange}}
    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.ScIdentify.Fields.Range.Label" }}</label>
      <div class="form-fields">
        <input type="number" name="identify.range" value="{{ range }}" min="0" step="any">
      </div>
      <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScIdentify.Fields.Range.Hint" }}</p>
    </div>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.RangeShape.Label" }}</label>
      <div class="form-fields">
        <select name="identify.rangeShape">
          {{ selectOptions rangeShapeOptions selected=rangeShape valueAttr="value" labelAttr="label" }}
        </select>
      </div>
    </div>
    {{/if}}
  </fieldset>

  <fieldset>
    <legend>{{ localize "SCMOREACTIVITIES.Activities.ScIdentify.Sections.Check" }}</legend>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.ScIdentify.Fields.Check.Label" }}</label>
      <div class="form-fields">
        <select name="checkSelection">
          {{ selectOptions checkOptions selected=checkSelection valueAttr="value" labelAttr="label" }}
        </select>
      </div>
      <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScIdentify.Fields.Check.Hint" }}</p>
    </div>

    {{#if checkEnabled}}
    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.ScIdentify.Fields.DcMode.Label" }}</label>
      <div class="form-fields">
        <select name="identify.dcMode">
          {{ selectOptions dcModeOptions selected=dcMode valueAttr="value" labelAttr="label" }}
        </select>
        {{#unless dcByRarity}}
        <input type="text" name="identify.dcFormula" value="{{ dcFormula }}"
               placeholder="{{ localize "SCMOREACTIVITIES.Activities.ScIdentify.Fields.DcFormula.Placeholder" }}">
        {{/unless}}
      </div>
      <p class="hint">
        {{#if dcByRarity}}
        {{ localize "SCMOREACTIVITIES.Activities.ScIdentify.Fields.DcMode.HintRarity" }}
        {{else}}
        {{ localize "SCMOREACTIVITIES.Activities.ScIdentify.Fields.DcMode.HintFormula" }}
        {{/if}}
      </p>
    </div>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.ScIdentify.Fields.DefaultDc.Label" }}</label>
      <div class="form-fields">
        <input type="number" name="identify.defaultDc" value="{{ defaultDc }}" min="0" step="1">
      </div>
      <p class="hint">
        {{#if dcByRarity}}
        {{ localize "SCMOREACTIVITIES.Activities.ScIdentify.Fields.DefaultDc.Hint" }}
        {{else}}
        {{ localize "SCMOREACTIVITIES.Activities.ScIdentify.Fields.DefaultDc.HintFormula" }}
        {{/if}}
      </p>
    </div>
    {{/if}}
  </fieldset>

  {{#if checkEnabled}}
  {{#if dcByRarity}}
  <fieldset>
    <legend>{{ localize "SCMOREACTIVITIES.Activities.ScIdentify.Sections.Difficulty" }}</legend>
    <div class="sc-ma-identify-rarity-grid">
      {{#each rarities}}
      <label class="sc-ma-identify-rarity">
        <span>{{ this.label }}</span>
        <input type="number" name="identify.rarityDcs.{{ this.key }}" value="{{ this.dc }}" min="0" step="1"
               placeholder="{{ ../defaultDc }}">
      </label>
      {{/each}}
    </div>
    <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScIdentify.Fields.RarityDcs.Hint" }}</p>
  </fieldset>
  {{/if}}
  {{/if}}
</section>
