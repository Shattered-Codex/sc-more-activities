<section class="tab activity-{{ tab.id }} {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
  {{> "systems/dnd5e/templates/activity/parts/activity-effects.hbs" }}

  <fieldset>
    <legend>{{ localize "SCMOREACTIVITIES.Activities.ScMovement.Sections.Configuration" }}</legend>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.TargetSource.Label" }}</label>
      <div class="form-fields">
        <select name="movement.targetSource">
          {{ selectOptions targetSourceOptions selected=movement.targetSource valueAttr="value" labelAttr="label" }}
        </select>
      </div>
      <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.TargetSource.Hint" }}</p>
    </div>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.ScMovement.Fields.Type.Label" }}</label>
      <div class="form-fields">
        <select name="movement.type">
          {{ selectOptions movementTypeOptions selected=movement.type valueAttr="value" labelAttr="label" }}
        </select>
      </div>
      <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScMovement.Fields.Type.Hint" }}</p>
    </div>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.ScMovement.Fields.Distance.Label" }}</label>
      <div class="form-fields">
        <input type="number" name="movement.distance" value="{{ movement.distance }}" min="0" step="1">
      </div>
      <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScMovement.Fields.Distance.Hint" }}</p>
    </div>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.ScMovement.Fields.MaxRange.Label" }}</label>
      <div class="form-fields">
        <input type="number" name="movement.maxRange" value="{{ movement.maxRange }}" min="0" step="1">
      </div>
      <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScMovement.Fields.MaxRange.Hint" }}</p>
    </div>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.RangeShape.Label" }}</label>
      <div class="form-fields">
        <select name="movement.rangeShape">
          {{ selectOptions rangeShapeOptions selected=movement.rangeShape valueAttr="value" labelAttr="label" }}
        </select>
      </div>
      <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScMovement.Fields.RangeShape.Hint" }}</p>
    </div>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.MaxTargets.Label" }}</label>
      <div class="form-fields">
        <input type="number" name="movement.maxTargets" value="{{ movement.maxTargets }}" min="1" step="1">
      </div>
      <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.MaxTargets.Hint" }}</p>
    </div>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.TargetSize.Label" }}</label>
      <div class="form-fields">
        <select name="movement.targetSize.mode">
          {{#each targetSizeModeOptions as |option|}}
            <option value="{{ option.value }}" {{#if (eq option.value ../movement.targetSize.mode)}}selected{{/if}}>{{ option.label }}</option>
          {{/each}}
        </select>
      </div>
      <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.TargetSize.Hint" }}</p>
    </div>

    {{#if targetSizeIsAbsolute}}
      <div class="form-group sc-ma-size-group">
        <label>{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.TargetSize.Sizes.Label" }}</label>
        <div class="form-fields sc-ma-size-choices">
          {{#each targetSizeOptions as |option|}}
            <label class="checkbox sc-ma-size-choice">
              <input type="checkbox" name="movement.targetSize.sizes" value="{{ option.value }}" {{#if option.selected}}checked{{/if}}>
              {{ option.label }}
            </label>
          {{/each}}
        </div>
        <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.TargetSize.Sizes.Hint" }}</p>
      </div>
    {{/if}}

    {{#if targetSizeIsRelative}}
      <div class="form-group">
        <label>{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.TargetSize.Offsets.Label" }}</label>
        <div class="form-fields sc-ma-size-offsets">
          <select name="movement.targetSize.minOffset">
            {{#each targetSizeOffsetOptions as |option|}}
              <option value="{{ option.value }}" {{#if (eq option.value ../movement.targetSize.minOffset)}}selected{{/if}}>{{ option.label }}</option>
            {{/each}}
          </select>
          <span class="sc-ma-size-offsets-sep">&mdash;</span>
          <select name="movement.targetSize.maxOffset">
            {{#each targetSizeOffsetOptions as |option|}}
              <option value="{{ option.value }}" {{#if (eq option.value ../movement.targetSize.maxOffset)}}selected{{/if}}>{{ option.label }}</option>
            {{/each}}
          </select>
        </div>
        <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.TargetSize.Offsets.Hint" }}</p>
      </div>
    {{/if}}

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.SnapToGrid.Label" }}</label>
      <div class="form-fields">
        <input type="checkbox" name="movement.snapToGrid" {{#if movement.snapToGrid}}checked{{/if}}>
      </div>
      <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.SnapToGrid.Hint" }}</p>
    </div>
  </fieldset>

  {{#if movementShowsSave}}
    <fieldset>
      <legend>{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.Save.Legend" }}</legend>

      <div class="form-group">
        <label>{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.Save.Enabled.Label" }}</label>
        <div class="form-fields">
          <input type="checkbox" name="movement.save.enabled" {{#if movement.save.enabled}}checked{{/if}}>
        </div>
        <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.Save.Enabled.Hint" }}</p>
      </div>

      {{#if movement.save.enabled}}
        <div class="form-group">
          <label>{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.Save.Ability.Label" }}</label>
          <div class="form-fields">
            <select name="movement.save.ability">
              {{ selectOptions saveAbilityOptions selected=movement.save.ability valueAttr="value" labelAttr="label" }}
            </select>
          </div>
          <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.Save.Ability.Hint" }}</p>
        </div>

        <div class="form-group">
          <label>{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.Save.Dc.Label" }}</label>
          <div class="form-fields">
            <input type="text" name="movement.save.dc" value="{{ movement.save.dc }}" placeholder="8 + @prof + @abilities.str.mod">
          </div>
          <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.Canvas.Fields.Save.Dc.Hint" }}</p>
        </div>
      {{/if}}
    </fieldset>
  {{/if}}
</section>
