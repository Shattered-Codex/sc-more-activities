<section class="tab activity-{{ tab.id }} {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
  {{> "systems/dnd5e/templates/activity/parts/activity-effects.hbs" }}

  <fieldset>
    <legend>{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Sections.Configuration" }}</legend>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Recipient.Label" }}</label>
      <div class="form-fields">
        <select name="recipient">
          {{ selectOptions recipientOptions selected=recipient valueAttr="value" labelAttr="label" }}
        </select>
      </div>
      <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Recipient.Hint" }}</p>
    </div>

    <div class="form-group">
      <label>{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Selection.Label" }}</label>
      <div class="form-fields sc-ma-grant-mode">
        <div class="sc-ma-segmented" role="radiogroup">
          {{#each selectionModeOptions}}
          <label class="sc-ma-segmented-option {{#if this.selected}}active{{/if}}">
            <input type="radio" name="selection.mode" value="{{ this.value }}" {{ checked this.selected }}>
            <i class="{{ this.icon }}" inert></i>
            <span>{{ this.label }}</span>
          </label>
          {{/each}}
        </div>
        {{#if isChoose}}
        <input type="number" class="sc-ma-grant-choice-count" name="selection.count" value="{{ selection.count }}"
               min="1" step="1" aria-label="{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Selection.Count" }}"
               data-tooltip="{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Selection.Count" }}">
        {{/if}}
        {{#if isBudget}}
        <input type="text" class="sc-ma-grant-budget" name="selection.budget" value="{{ selection.budget }}"
               placeholder="10" aria-label="{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Selection.Budget" }}"
               data-tooltip="{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Selection.BudgetTooltip" }}">
        {{/if}}
      </div>
      <p class="hint">{{ selectionHint }}</p>
    </div>
  </fieldset>

  <fieldset data-grant-list>
    <legend>
      <span>{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Sections.Items" }}</span>
      {{#if selectionBadge}}<span class="sc-ma-grant-badge">{{ selectionBadge }}</span>{{/if}}
      <i class="fa-solid fa-circle-info sc-ma-info-icon"
         data-tooltip="{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Quantity.Tooltip" }}"></i>
      <button type="button" class="unbutton control-button" data-action="add-grant"
              data-tooltip aria-label="{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Source.Add" }}">
        <i class="fas fa-plus" inert></i>
      </button>
    </legend>

    <ul class="sc-ma-grant-list unlist">
      {{#each grants}}
      <li class="sc-ma-grant-row {{#if this.missing}}is-missing{{/if}}" data-index="{{ this.index }}">
        <input type="hidden" name="grants.{{ this.index }}.type" value="{{ this.type }}">
        <input type="hidden" name="grants.{{ this.index }}.uuid" value="{{ this.uuid }}">

        <input type="text" class="sc-ma-grant-qty" name="grants.{{ this.index }}.quantity" value="{{ this.quantity }}"
               placeholder="1" aria-label="{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Quantity.Label" }}">

        <span class="sc-ma-grant-sep">&times;</span>

        {{#if this.uuid}}
        <div class="sc-ma-grant-source" data-tooltip="{{ this.uuid }}">
          <img src="{{ this.img }}" alt="{{ this.name }}">
          <div class="sc-ma-grant-meta">
            <span class="sc-ma-grant-name">{{ this.name }}</span>
            <span class="sc-ma-grant-type">
              {{ this.typeLabel }}{{#if this.missing}} &mdash; {{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Source.Missing" }}{{/if}}
            </span>
          </div>
        </div>
        {{else}}
        <input type="text" class="sc-ma-grant-drop" data-grant-drop data-index="{{ this.index }}"
               placeholder="{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Source.DropHint" }}">
        {{/if}}

        {{#if ../isBudget}}
        <label class="sc-ma-grant-cost" data-tooltip="{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Cost.Tooltip" }}">
          <i class="fa-solid fa-weight-hanging" inert></i>
          <input type="number" name="grants.{{ this.index }}.cost" value="{{ this.cost }}" min="1" step="1"
                 aria-label="{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Cost.Label" }}">
        </label>
        {{/if}}

        <button type="button" class="unbutton control-button" data-action="remove-grant" data-index="{{ this.index }}"
                data-tooltip aria-label="{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Source.Remove" }}">
          <i class="fas fa-minus" inert></i>
        </button>
      </li>
      {{else}}
      <li class="sc-ma-grant-empty">{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Items.Empty" }}</li>
      {{/each}}
    </ul>

    <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Source.Hint" }}</p>
  </fieldset>

  {{#if isFacility}}
  <div class="sc-ma-collapsible {{#unless bastionTrayExpanded}}collapsed{{/unless}}" data-grant-bastion-tray>
    <button type="button" class="sc-ma-collapsible-header" data-action="toggle-bastion-tray">
      <i class="fa-solid fa-chess-rook" inert></i>
      <span>{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Sections.Bastion" }}</span>
      {{#if bastionEnabled}}<span class="sc-ma-grant-badge">{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Delivery.Choices.Bastion" }}</span>{{/if}}
      <i class="fa-solid fa-caret-down" inert></i>
    </button>
    <div class="sc-ma-collapsible-content">
      <fieldset>
        <div class="form-group">
          <label>{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Delivery.Label" }}</label>
          <div class="form-fields">
            <select name="delivery">
              {{ selectOptions deliveryOptions selected=delivery valueAttr="value" labelAttr="label" }}
            </select>
          </div>
          <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Delivery.Hint" }}</p>
        </div>

        {{#if bastionEnabled}}
        <div class="form-group">
          <label>{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Bastion.Order" }}</label>
          <div class="form-fields sc-ma-grant-bastion-order">
            <select name="bastion.order">
              {{ selectOptions bastionOrderOptions selected=bastion.order valueAttr="value" labelAttr="label" }}
            </select>
            <input type="number" name="bastion.days" value="{{ bastion.days }}" min="1" step="1"
                   aria-label="{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Bastion.Days" }}">
            <span class="sc-ma-grant-unit">{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Bastion.DaysUnit" }}</span>
          </div>
          <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Bastion.Hint" }}</p>
        </div>

        {{/if}}

        {{#if bastionStatus}}
        <div class="sc-ma-grant-bastion-status {{#if bastionStatus.undelivered}}is-undelivered{{/if}}">
          <div class="sc-ma-grant-bastion-status-label">
            <i class="fa-solid {{#if bastionStatus.undelivered}}fa-triangle-exclamation{{else}}fa-hourglass-half{{/if}}" inert></i>
            <span>{{ bastionStatus.label }}</span>
          </div>
          <div class="sc-ma-grant-progress" role="progressbar" aria-valuenow="{{ bastionStatus.pct }}" aria-valuemin="0" aria-valuemax="100">
            <span style="width: {{ bastionStatus.pct }}%"></span>
          </div>
          {{#if bastionStatus.sources}}<span class="sc-ma-grant-bastion-status-sources">{{ bastionStatus.sources }}</span>{{/if}}
          {{#if bastionStatus.canResolve}}
          <div class="sc-ma-grant-bastion-status-actions">
            <button type="button" data-action="retry-bastion-delivery">
              <i class="fa-solid fa-rotate-right" inert></i> {{ localize "SCMOREACTIVITIES.Activities.ScGrant.Bastion.Retry" }}
            </button>
            <button type="button" data-action="discard-bastion-delivery">
              <i class="fa-solid fa-trash" inert></i> {{ localize "SCMOREACTIVITIES.Activities.ScGrant.Bastion.Discard" }}
            </button>
          </div>
          {{/if}}
        </div>
        {{/if}}
      </fieldset>
    </div>
  </div>
  {{/if}}

  <div class="sc-ma-collapsible {{#unless advancedTrayExpanded}}collapsed{{/unless}}" data-grant-advanced-tray>
    <button type="button" class="sc-ma-collapsible-header" data-action="toggle-advanced-tray">
      <i class="fa-solid fa-sliders" inert></i>
      <span>{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Sections.Advanced" }}</span>
      {{#if itemFlags.length}}<span class="sc-ma-grant-badge">{{ itemFlags.length }}</span>{{/if}}
      <i class="fa-solid fa-caret-down" inert></i>
    </button>
    <div class="sc-ma-collapsible-content">
      <fieldset>
        <legend>
          <span>{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.ItemFlags.Label" }}</span>
          <button type="button" class="unbutton control-button" data-action="add-item-flag"
                  data-tooltip aria-label="{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.ItemFlags.Add" }}">
            <i class="fas fa-plus" inert></i>
          </button>
        </legend>
        <ul class="sc-ma-grant-flag-list unlist">
          {{#each itemFlags}}
          <li class="sc-ma-grant-flag-row {{#if this.invalid}}is-invalid{{/if}}">
            <input type="text" name="itemFlags.{{ this.index }}.key" value="{{ this.key }}"
                   placeholder="{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.ItemFlags.KeyPlaceholder" }}"
                   aria-label="{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.ItemFlags.Key" }}"
                   {{#if this.invalid}}data-tooltip="{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.ItemFlags.Invalid" }}"{{/if}}>
            <span class="sc-ma-grant-sep">=</span>
            <input type="text" name="itemFlags.{{ this.index }}.value" value="{{ this.value }}"
                   placeholder="{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.ItemFlags.ValuePlaceholder" }}"
                   aria-label="{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.ItemFlags.Value" }}">
            <button type="button" class="unbutton control-button" data-action="remove-item-flag" data-index="{{ this.index }}"
                    data-tooltip aria-label="{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.ItemFlags.Remove" }}">
              <i class="fas fa-minus" inert></i>
            </button>
          </li>
          {{else}}
          <li class="sc-ma-grant-empty">{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.ItemFlags.Empty" }}</li>
          {{/each}}
        </ul>
        <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.ItemFlags.Hint" }}</p>
      </fieldset>
    </div>
  </div>

  <div class="sc-ma-collapsible {{#unless checkTrayExpanded}}collapsed{{/unless}}" data-grant-check-tray>
    <button type="button" class="sc-ma-collapsible-header" data-action="toggle-check-tray">
      <i class="fa-solid fa-gears" inert></i>
      <span>{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Sections.Check" }}</span>
      <i class="fa-solid fa-caret-down" inert></i>
    </button>
    <div class="sc-ma-collapsible-content">
      <fieldset>
        <div class="form-group">
          <label>{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Check.Kind.Label" }}</label>
          <div class="form-fields">
            <select name="checkSelection">
              {{ selectOptions checkKindOptions selected=checkSelection valueAttr="value" labelAttr="label" }}
            </select>
          </div>
          <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Check.Kind.Hint" }}</p>
        </div>

        <div class="form-group">
          <label>{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Check.DC.Label" }}</label>
          <div class="form-fields">
            <select name="check.dc.calculation">
              {{ selectOptions checkCalculationOptions selected=check.dc.calculation valueAttr="value" labelAttr="label" }}
            </select>
            {{#if showDcFormula}}
            <input type="text" name="check.dc.formula" value="{{ check.dc.formula }}"
                   placeholder="{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Check.DC.FormulaPlaceholder" }}">
            {{else}}
            <input type="text" value="{{ dcPreview }}" disabled>
            <input type="hidden" name="check.dc.formula" value="{{ check.dc.formula }}">
            {{/if}}
          </div>
          <p class="hint">{{ localize "SCMOREACTIVITIES.Activities.ScGrant.Fields.Check.DC.Hint" }}</p>
        </div>
      </fieldset>
    </div>
  </div>
</section>
