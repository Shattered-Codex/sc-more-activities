<section class="sc-ma-config" data-application-part="body">
  <div class="sc-ma-config__body">
    <nav class="sc-ma-config__rail" role="tablist" aria-label="{{ strings.tabsAria }}">
      {{#each tabs}}
        <button
          type="button"
          role="tab"
          id="{{ ../formId }}-tab-{{ this.id }}"
          class="sc-ma-config__tab{{#if this.active}} is-active{{/if}}"
          data-action="switchTab"
          data-tab-target="{{ this.id }}"
          aria-selected="{{#if this.active}}true{{else}}false{{/if}}"
          aria-controls="{{ ../formId }}-panel-{{ this.id }}"
          tabindex="{{#if this.active}}0{{else}}-1{{/if}}"
        >
          <i class="{{ this.icon }}" aria-hidden="true"></i>
          <span class="sc-ma-config__tab-label">{{ this.label }}</span>
          <span class="sc-ma-config__tab-dot" data-tab-dot="{{ this.id }}" hidden></span>
        </button>
      {{/each}}
    </nav>

    <div class="sc-ma-config__content">
      {{#unless isGM}}
        <p class="sc-ma-config__notice">
          <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
          {{ playerNotice }}
        </p>
      {{/unless}}

      {{#each sections}}
        <section
          id="{{ ../formId }}-panel-{{ this.id }}"
          class="sc-ma-config__panel"
          role="tabpanel"
          aria-labelledby="{{ ../formId }}-tab-{{ this.id }}"
          data-tab-panel="{{ this.id }}"
          {{#unless this.active}}hidden{{/unless}}
        >
          <header class="sc-ma-config__panel-head">
            <h2 class="sc-ma-config__panel-title">{{ this.title }}</h2>
            <p class="sc-ma-config__panel-hint">{{ this.hint }}</p>
          </header>

          <div class="sc-ma-config__rows">
            {{#each this.fields}}
              <label class="sc-ma-config-row">
                <span class="sc-ma-config-row__copy">
                  <span class="sc-ma-config-row__name">{{ this.name }}</span>
                  <span class="sc-ma-config-row__hint">{{ this.hint }}</span>
                </span>
                <span class="sc-ma-config-row__control">
                  {{#if this.isNumber}}
                    <input
                      type="number"
                      name="{{ this.key }}"
                      class="sc-ma-input sc-ma-input--number"
                      value="{{ this.value }}"
                      min="{{ this.min }}"
                      max="{{ this.max }}"
                      step="{{ this.step }}"
                      data-default-value="{{ this.defaultValue }}"
                    />
                  {{/if}}
                  {{#if this.isCheckbox}}
                    <span class="sc-ma-check">
                      <input
                        type="checkbox"
                        name="{{ this.key }}"
                        {{#if this.checked}}checked{{/if}}
                        data-default-checked="{{ this.defaultChecked }}"
                      />
                      <span class="sc-ma-check__box"><i class="fas fa-check" aria-hidden="true"></i></span>
                    </span>
                  {{/if}}
                </span>
              </label>
            {{/each}}
          </div>
        </section>
      {{/each}}
    </div>
  </div>

  <footer class="sc-ma-config__footer">
    <span class="sc-ma-config-pill" data-status-pill hidden>
      <span class="sc-ma-config-pill__dot" aria-hidden="true"></span>
      <span data-status-pill-label></span>
    </span>
    <span class="sc-ma-config__spacer"></span>
    <button type="button" class="sc-ma-btn sc-ma-btn--ghost" data-action="resetActiveTab">
      <i class="fas fa-rotate-left" aria-hidden="true"></i> {{ strings.reset }}
    </button>
    <button type="button" class="sc-ma-btn" data-action="close">
      <i class="fas fa-xmark" aria-hidden="true"></i> {{ strings.close }}
    </button>
    <button type="button" class="sc-ma-btn sc-ma-btn--primary" data-action="save" data-save-button>
      <i class="fas fa-floppy-disk" aria-hidden="true"></i> {{ strings.save }}
    </button>
  </footer>
</section>
