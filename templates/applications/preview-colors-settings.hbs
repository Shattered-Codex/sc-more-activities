{{!-- The root keeps `sc-ma-preview-colors-shell`: it declares the --sc-ma-preview-*
      custom properties the sample overlays read, and the app writes the live
      values onto this same element. --}}
<section class="sc-ma-config sc-ma-preview-colors-shell">
  <div class="sc-ma-config__body">
    <nav class="sc-ma-config__rail" role="tablist" aria-label="{{ localize "SCMOREACTIVITIES.Settings.PreviewColorsMenu.Scope.Label" }}">
      {{#each scopeOptions}}
        <button
          type="button"
          role="tab"
          id="sc-ma-preview-tab-{{ this.value }}"
          class="sc-ma-config__tab{{#if this.selected}} is-active{{/if}}"
          data-action="switchScope"
          data-scope="{{ this.value }}"
          aria-selected="{{#if this.selected}}true{{else}}false{{/if}}"
          tabindex="{{#if this.selected}}0{{else}}-1{{/if}}"
        >
          <i class="{{ this.icon }}" aria-hidden="true"></i>
          <span class="sc-ma-config__tab-label">{{ this.label }}</span>
        </button>
      {{/each}}
    </nav>

    <div class="sc-ma-config__content">
      <header class="sc-ma-config__panel-head">
        <h2 class="sc-ma-config__panel-title">{{ scopeLabel }}</h2>
        <p class="sc-ma-config__panel-hint">{{ scopeHint }}</p>
      </header>

      <div class="sc-ma-preview-single">
        <article class="sc-ma-preview-card sc-ma-preview-card--{{ selectedScope }}">
          <div class="sc-ma-preview-card-label">{{ scopeLabel }}</div>
          <div class="sc-ma-preview-stage sc-ma-preview-stage--{{ selectedScope }}">
            {{#if isTeleportScope}}
              <div class="sc-ma-preview-range"></div>
              <div class="sc-ma-preview-origin"></div>
              <div class="sc-ma-preview-destination"></div>
            {{/if}}

            {{#if isMovementScope}}
              <div class="sc-ma-preview-range"></div>
              <div class="sc-ma-preview-origin"></div>
              <div class="sc-ma-preview-path"></div>
              <div class="sc-ma-preview-start"></div>
              <div class="sc-ma-preview-end"></div>
            {{/if}}

            {{#if isPortalScope}}
              <div class="sc-ma-preview-range"></div>
              <div class="sc-ma-preview-origin"></div>
              <div class="sc-ma-preview-portal-link"></div>
              <div class="sc-ma-preview-portal-side sc-ma-preview-portal-side--entry"></div>
              <div class="sc-ma-preview-portal-side sc-ma-preview-portal-side--exit"></div>
            {{/if}}

            {{#if isWallScope}}
              <div class="sc-ma-preview-range"></div>
              <div class="sc-ma-preview-origin"></div>
              <div class="sc-ma-preview-wall-line sc-ma-preview-wall-line--one"></div>
              <div class="sc-ma-preview-wall-line sc-ma-preview-wall-line--two"></div>
            {{/if}}
          </div>
        </article>
      </div>

      <div class="sc-ma-config__rows">
        {{#each colorFields as |field|}}
          <label class="sc-ma-config-row" for="{{ field.id }}">
            <span class="sc-ma-config-row__copy">
              <span class="sc-ma-config-row__name">{{ field.label }}</span>
              <span class="sc-ma-config-row__hint">{{ field.hint }}</span>
            </span>
            <span class="sc-ma-config-row__control">
              <span class="sc-ma-color-control" data-color-control="{{ field.key }}">
                <input
                  type="text"
                  class="sc-ma-input sc-ma-hex-input"
                  data-hex-for="{{ field.key }}"
                  value="{{ field.value }}"
                  maxlength="7"
                  spellcheck="false"
                  autocomplete="off"
                  aria-label="{{ field.label }}"
                />
                <input id="{{ field.id }}" type="color" name="{{ field.key }}" class="sc-ma-color-picker" value="{{ field.value }}">
              </span>
            </span>
          </label>
        {{/each}}
      </div>
    </div>
  </div>

  <footer class="sc-ma-config__footer">
    <button type="button" class="sc-ma-btn sc-ma-btn--ghost" data-action="reset">
      <i class="fas fa-rotate-left" aria-hidden="true"></i>
      {{ localize "SCMOREACTIVITIES.Actions.ResetDefaults" }}
    </button>
    <span class="sc-ma-config__spacer"></span>
    <button type="button" class="sc-ma-btn" data-action="cancel">
      <i class="fas fa-times" aria-hidden="true"></i>
      {{ localize "SCMOREACTIVITIES.Actions.Cancel" }}
    </button>
    <button type="button" class="sc-ma-btn sc-ma-btn--primary" data-action="save">
      <i class="fas fa-save" aria-hidden="true"></i>
      {{ localize "SCMOREACTIVITIES.Actions.Save" }}
    </button>
  </footer>
</section>
