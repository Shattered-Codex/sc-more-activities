{{!-- Laid out like the SC colour editors (item rarity, NPC and character
      colours): overlays on the rail, a live preview beside compact colour rows.
      The root keeps `sc-ma-preview-colors-shell`: it declares the
      --sc-ma-preview-* custom properties the sample overlay and the rail
      swatches read, and the app writes the live values onto this element. --}}
<section class="sc-ma-config sc-ma-preview-colors-shell">
  <div class="sc-ma-config__body sc-ma-color-editor__body">
    <aside class="sc-ma-config__rail sc-ma-color-editor__rail">
      <h3 class="sc-ma-color-editor__eyebrow">{{ localize "SCMOREACTIVITIES.Settings.PreviewColorsMenu.Scope.Title" }}</h3>
      <nav class="sc-ma-color-editor__rail-list" role="tablist" aria-label="{{ localize "SCMOREACTIVITIES.Settings.PreviewColorsMenu.Scope.Label" }}">
        {{#each scopeOptions}}
          <button
            type="button"
            role="tab"
            id="sc-ma-preview-tab-{{ this.value }}"
            class="sc-ma-config__tab{{#if this.selected}} is-active{{/if}}"
            data-action="switchScope"
            data-scope="{{ this.value }}"
            aria-selected="{{#if this.selected}}true{{else}}false{{/if}}"
            tabindex="{{#if this.selected}}0{{else}}-1{{/if}}"
          >
            <span class="sc-ma-color-editor__swatch sc-ma-color-editor__swatch--{{ this.value }}" aria-hidden="true"></span>
            <span class="sc-ma-config__tab-label">{{ this.label }}</span>
            <span class="sc-ma-config__tab-dot" data-scope-dot="{{ this.value }}" {{#unless this.dirty}}hidden{{/unless}}></span>
          </button>
        {{/each}}
      </nav>
    </aside>

    <div class="sc-ma-color-editor__main">
      <header class="sc-ma-color-editor__head">
        <h2 class="sc-ma-config__panel-title">
          <i class="{{ scopeIcon }}" aria-hidden="true"></i>
          {{ scopeLabel }}
        </h2>
        <p class="sc-ma-config__panel-hint">{{ scopeHint }}</p>
      </header>

      <div class="sc-ma-color-editor__grid">
        <section class="sc-ma-color-editor__preview" aria-label="{{ localize "SCMOREACTIVITIES.Settings.PreviewColorsMenu.Preview.Title" }}">
          <h3 class="sc-ma-color-editor__eyebrow">{{ localize "SCMOREACTIVITIES.Settings.PreviewColorsMenu.Preview.Title" }}</h3>
          <div class="sc-ma-preview-stage sc-ma-preview-stage--{{ selectedScope }}">
            {{!-- Every scope shows a few blocked spaces inside its range. --}}
            <div class="sc-ma-preview-blocked" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>

            {{#if isTeleportScope}}
              <div class="sc-ma-preview-range"></div>
              <div class="sc-ma-preview-origin"></div>
              <div class="sc-ma-preview-destination"></div>
            {{/if}}

            {{#if isMovementScope}}
              <div class="sc-ma-preview-range"></div>
              <div class="sc-ma-preview-origin"></div>
              <div class="sc-ma-preview-path"></div>
              <div class="sc-ma-preview-start"></div>
              <div class="sc-ma-preview-end"></div>
            {{/if}}

            {{#if isPortalScope}}
              <div class="sc-ma-preview-range"></div>
              <div class="sc-ma-preview-origin"></div>
              <div class="sc-ma-preview-portal-link"></div>
              <div class="sc-ma-preview-portal-side sc-ma-preview-portal-side--entry"></div>
              <div class="sc-ma-preview-portal-side sc-ma-preview-portal-side--exit"></div>
            {{/if}}

            {{#if isWallScope}}
              <div class="sc-ma-preview-range"></div>
              <div class="sc-ma-preview-origin"></div>
              <div class="sc-ma-preview-wall-line sc-ma-preview-wall-line--one"></div>
              <div class="sc-ma-preview-wall-line sc-ma-preview-wall-line--two"></div>
            {{/if}}
          </div>
          <p class="sc-ma-color-editor__note">{{ localize "SCMOREACTIVITIES.Settings.PreviewColorsMenu.Preview.Hint" }}</p>
        </section>

        <section class="sc-ma-color-editor__fields">
          <h3 class="sc-ma-color-editor__eyebrow">{{ localize "SCMOREACTIVITIES.Settings.PreviewColorsMenu.Fields.Title" }}</h3>
          <div class="sc-ma-color-editor__rows">
            {{#each colorFields as |field|}}
              <div class="sc-ma-color-editor__row">
                {{!-- Compact rows like the other SC colour editors: the hint lives in a tooltip. --}}
                <label class="sc-ma-color-editor__label" for="{{ field.id }}" data-tooltip="{{ field.hint }}">
                  <span class="sc-ma-color-editor__name">{{ field.label }}</span>
                  <i class="fa-solid fa-circle-info sc-ma-color-editor__info" aria-hidden="true"></i>
                </label>
                <span class="sc-ma-color-control" data-color-control="{{ field.key }}">
                  <input
                    type="text"
                    class="sc-ma-input sc-ma-hex-input"
                    data-hex-for="{{ field.key }}"
                    value="{{ field.value }}"
                    maxlength="7"
                    spellcheck="false"
                    autocomplete="off"
                    aria-label="{{ field.label }}"
                  />
                  <input id="{{ field.id }}" type="color" name="{{ field.key }}" class="sc-ma-color-picker" value="{{ field.value }}">
                </span>
              </div>
            {{/each}}
          </div>
        </section>
      </div>
    </div>
  </div>

  <footer class="sc-ma-config__footer">
    <button type="button" class="sc-ma-btn sc-ma-btn--ghost" data-action="reset">
      <i class="fas fa-rotate-left" aria-hidden="true"></i>
      {{ localize "SCMOREACTIVITIES.Actions.ResetDefaults" }}
    </button>
    <span class="sc-ma-config__spacer"></span>
    <button type="button" class="sc-ma-btn" data-action="cancel">
      <i class="fas fa-xmark" aria-hidden="true"></i>
      {{ localize "SCMOREACTIVITIES.Actions.Close" }}
    </button>
    <button type="button" class="sc-ma-btn sc-ma-btn--primary{{#if isDirty}} is-dirty{{/if}}" data-action="save">
      <i class="fas fa-floppy-disk" aria-hidden="true"></i>
      {{ localize "SCMOREACTIVITIES.Actions.SaveChanges" }}
    </button>
  </footer>
</section>
